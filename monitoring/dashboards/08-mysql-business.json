          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, '1d'),\n  SUM(CASE WHEN source='llm' THEN 1 ELSE 0 END) AS llm_calls,\n  SUM(CASE WHEN source LIKE 'cache%' THEN 1 ELSE 0 END) AS cache_hits\nFROM llm_usage_events\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "每日模型调用量（llm_usage_events）",
      "type": "timeseries",
      "description": "需要先执行 db/migrations 中的 llm_usage_events 迁移。"
